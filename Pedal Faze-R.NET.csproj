<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build §1.2 — mandatory properties for every managed machine.
       DebugType/DebugSymbols/GenerateDependencyFile keep .pdb and .deps.json
       out of C:\Program Files\ReBuzz (only the .dll is loaded at runtime). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>

    <!-- Build §2 — the ".NET" suffix routes the DLL to ReBuzz's managed loader;
         the filename (minus ".NET") is the machine-browser display name. -->
    <AssemblyName>Pedal Faze-R.NET</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- ReBuzz provides this at runtime; <Private>false</Private> stops a local
       copy being emitted (Build §6 / Presets §6). -->
  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>C:\Program Files\ReBuzz\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Preset bundle (Build §3). Declared as an ItemGroup item so the embedded
       space in the filename round-trips into the Copy task (Build §3.5). -->
  <ItemGroup>
    <PresetBundle Include="Pedal Faze-R_Presets.prs.xml" />
  </ItemGroup>

  <!-- Build §1.3 — deploy the freshly-built DLL (and the preset bundle) into
       ReBuzz's generators folder after every build. ContinueOnError survives the
       file-lock when ReBuzz is running; $(TargetPath) deploys just the .dll. -->
  <Target Name="DeployToReBuzz" AfterTargets="Build">
    <Message Text="Deploying $(TargetFileName) -> C:\Program Files\ReBuzz\Gear\Generators\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />
    <Message Text="Deploying @(PresetBundle) -> C:\Program Files\ReBuzz\Gear\Generators\" Importance="high" />
    <Copy SourceFiles="@(PresetBundle)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />
  </Target>

</Project>
